{
  "name": "@s-berdia/opencode-router",
  "version": "1.0.0",
  "description": "Dynamic model routing for OpenCode Go / Go Plus / Free. Picks the best value-for-money model per agent (plan, build, general, explore) and rotates automatically so a 24/7 build plan never runs out.",
  "type": "module",
  "license": "MIT",
  "author": "s-berdia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-berdia/Opencode_router.git"
  },
  "homepage": "https://github.com/s-berdia/Opencode_router#readme",
  "bugs": {
    "url": "https://github.com/s-berdia/Opencode_router/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "router",
    "model-routing",
    "llm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-router": "dist/bin.js"
  },
  "files": [
    "dist",
    "model-scores.json",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "refresh": "node dist/bin.js refresh",
    "status": "node dist/bin.js status"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.23",
    "@types/node": "^22.10.2",
    "jsonc-parser": "^3.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
